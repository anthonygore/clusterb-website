<div class="info-card">
    <p class="description">
        Cluster B is an alternative rock project from songwriter Anthony Gore based in Sydney, Australia.
    </p>

    {{> social}}

    <div class="analytics-badge">
        <a href="https://www.simpleanalytics.com?utm_source=clusterb.com&utm_content=badge" referrerpolicy="origin" target="_blank" rel="noopener noreferrer">
            <picture>
                <source
                    srcset="https://simpleanalyticsbadges.com/clusterb.com?mode=dark&counter=false"
                    media="(prefers-color-scheme: dark)"
                />
                <img
                    src="https://simpleanalyticsbadges.com/clusterb.com?mode=light&counter=false"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    crossorigin="anonymous"
                    alt="Simple Analytics badge"
                />
            </picture>
        </a>
    </div>
</div>
